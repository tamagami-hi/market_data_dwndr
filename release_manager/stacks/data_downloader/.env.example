# =============================================================================
# DATA_DOWNLOADER — production environment (VPS)
# =============================================================================
# Copy this file to `.env` ON THE VPS and fill every value once. The real `.env`
# is NEVER shipped and no script reads, writes or removes it: a deploy uploads
# images, compose, scripts and this template only, and only Docker reads `.env`
# (env_file and compose interpolation). Keep it 0600 and owned by the deploy
# user. This single file configures both the backend and the frontend runtime.
#
# Backend and frontend run on the SAME machine, so — exactly like local dev —
# they talk over localhost and the same images work locally and on the VPS. No
# fixed IP is required: reach the UI on the box or via an SSH tunnel, e.g.
#   ssh -L 3789:localhost:3789 -L 9000:localhost:9000 beonedge@<vps>
#   then open http://localhost:3789 in your browser.
# When you later get a static IP/domain, set NEXT_PUBLIC_BACKEND_URL + FRONTEND_URL
# to it (rebuild the frontend for the new NEXT_PUBLIC_BACKEND_URL) and point
# HOST_BIND_ADDRESS at the public interface.
#
# After editing, recreate the containers from the build machine with:
#   ./release_manager/status.sh --do reload --yes
# Where releases, rollbacks and logs live is in paths.json, not here.
# =============================================================================

# --- required: Kite Connect app credentials ---------------------------------
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret

# --- required: host data roots (env-driven; bind-mounted r/w into the container)
# SSD live capture root and the separate durable archive root. These MUST already
# exist on the VPS, be owned by APP_UID:APP_GID, and live OUTSIDE the deploy folder
# (which is replaced on every update). Bind-mounted at the SAME path in-container.
MARKET_DATA_PATH=/srv/dev_stack/MARKET_DATA
ARCHIVE_DATA_PATH=/srv/data/DATA_DOWNLOADER/ARCHIVE

# --- monitor statistics store (env-driven) -----------------------------------
# Directory for persisted dashboard statistics JSON (compression history + daily
# capture snapshots). Keep it UNDER MARKET_DATA_PATH (already bind-mounted at the
# same path in-container and owned by APP_UID:APP_GID) so it persists across
# deploys without an extra volume. Leave unset to default to MARKET_DATA_PATH/_state/stats.
STATS_DATA_PATH=/srv/dev_stack/MARKET_DATA/_state/stats

# --- networking (localhost / same-machine, like local dev) -------------------
# IN-CONTAINER bind address for uvicorn. In Docker this MUST be 0.0.0.0, or the
# published port cannot reach the app. Host exposure is set by HOST_BIND_ADDRESS.
HTTP_HOST=0.0.0.0
HTTP_PORT=9000
# Frontend serve port.
PORT=3789
# The ONLY host address both services publish on. Loopback keeps it private and is
# reached via the SSH tunnel above (recommended now). Set to 0.0.0.0 to expose on
# the office LAN, or to your static IP later. NOTE: 0.0.0.0 puts the unauthenticated
# API on the network — only do that on a trusted/whitelisted network.
HOST_BIND_ADDRESS=127.0.0.1
# Non-root container identity; MARKET_DATA_PATH/ARCHIVE_DATA_PATH must be owned by it.
APP_UID=10001
APP_GID=10001
# Browser origin allowed by CORS + WebSocket. Same machine → localhost, matching the
# tunnel/on-box browser and the frontend PORT. Change to the static IP/domain later.
FRONTEND_URL=http://localhost:3789

# --- automated login (seeded so the daily automation runs unattended) --------
# Kite token from the broker login service's token API. Set all four together.
# The URL is https://<subdomain>.beonedge.in/api/v1/token (the subdomain only lives here).
KITE_TOKEN_BROKER_URL=https://your_subdomain.beonedge.in/api/v1/token
# The Cloudflare Access service token the token API's Access policy allows.
KITE_TOKEN_BROKER_CF_CLIENT_ID=replace_with_the_service_token_client_id
KITE_TOKEN_BROKER_CF_CLIENT_SECRET=replace_with_the_service_token_client_secret
# The token API seed the broker login dashboard showed once when the account was added
# (base32). It is not the Zerodha login TOTP seed.
KITE_TOKEN_BROKER_TOTP_SEED=replace_with_the_token_api_seed
KITE_USER_ID=your_zerodha_user_id
KITE_PASSWORD=your_zerodha_password
# Daily risk-free rate broker (calspread), sent KITE_TOKEN_BROKER_PASSCODE as
# x-token-passcode; returns a percent, converted to a decimal by the backend.
KITE_TOKEN_BROKER_PASSCODE=replace_with_the_rotated_shared_passcode
KITE_RATE_BROKER_URL=https://calspread.online/api/rf
# Fallback risk-free rate (decimal) used only if the rate broker is unavailable.
RISK_FREE_RATE=0.064

# --- release drain lease (required by the deploy script) ---------------------
# Generate once: openssl rand -hex 32
# Authenticates X-Release-Maintenance-Token so the deploy can flush writers.
RELEASE_MAINTENANCE_TOKEN=replace_with_at_least_32_url_safe_characters
RELEASE_MAINTENANCE_TTL_SECONDS=900

# --- optional (locked defaults shown) ----------------------------------------
INDICES=NIFTY,BANKNIFTY,FINNIFTY,SENSEX
# Comma-separated NSE/BSE closure dates (YYYY-MM-DD); update before each year.
MARKET_HOLIDAYS=
STOCK_UNIVERSE=all
CAPTURE_HZ=1
ZSTD_LEVEL=17
# EOD compression worker threads per file (1..6).
ZSTD_THREADS=6
AUTH_POLL_START=08:30
AUTH_POLL_END=09:00
AUTH_POLL_INTERVAL_SECONDS=60
# --- session timings: 2026 exchange structure ---------------------------------------
# THREE different clocks. Do not collapse them into one window.
#
#   equity derivatives  09:15 -> 15:40 continuous       (23,100 owed seconds)
#   F&O cash underlying 09:15 -> 15:15 continuous       (21,600 owed seconds)
#                       15:15 -> 15:35 closing auction  (1,200 s, captured, NOT owed)
#   process envelope    09:10 -> 15:40                  (23,400 s, owes nothing extra)
#
# The capture PROCESS envelope. 09:10 gets the socket and subscriptions up before the
# first print; 09:10-09:15 is reported as `unscheduled`, never as data loss.
CAPTURE_START_TIME=09:10
CAPTURE_END_TIME=15:40
# Drain tail between CAPTURE_END_TIME and EOD compression/archive finalization, so the
# final derivative frames are flushed before the raw .bin is compressed and moved
# (compression REMOVES the raw file). EOD therefore runs at 15:42 - never at 15:30, and
# never while derivatives are still trading. This is a drain allowance, not a longer
# session: nothing is owed in the tail.
EOD_TAIL_SECONDS=120
# Broad market/UI display envelope and the expected-frames baseline. NOT how the segments
# below get their schedule - it is only a last-resort fallback for a blanked value.
MARKET_OPEN=09:15
MARKET_CLOSE=15:40
TIMEZONE=Asia/Kolkata
# Equity derivatives: index and stock futures/options trade through the cash closing
# auction to 15:40. Not 15:30, and not 15:20 (15:20 is a CASH auction stage).
EQUITY_DERIV_PREOPEN_START=09:00
EQUITY_DERIV_PREOPEN_END=09:15
EQUITY_DERIV_CAPTURE_PREOPEN=false
EQUITY_DERIV_OPEN=09:15
EQUITY_DERIV_CLOSE=15:40
EQUITY_DERIV_ENABLED=true
# F&O-eligible cash underlyings: CONTINUOUS matching ends at 15:15, then the closing
# auction runs to 15:35. Inside the auction frames are still persisted, continuous stale
# detection is NOT armed, and unchanged values are NOT treated as a feed outage; those
# seconds are tracked separately and never enter the loss denominator. Do NOT set
# EQUITY_CASH_CLOSE=15:40 to silence auction alarms - that hides the exchange structure.
EQUITY_CASH_OPEN=09:15
EQUITY_CASH_CLOSE=15:15
EQUITY_CASH_CAS_START=15:15
EQUITY_CASH_CAS_END=15:35
EQUITY_CASH_CAPTURE_AUCTION=true
EQUITY_CASH_CAPTURE_PREOPEN=false
EQUITY_CASH_ENABLED=true
# Session governing FRESHNESS for the six index spot values and India VIX. An index value
# is a function of its cash constituents, so from 15:15 an unmoving level is the cash
# auction rather than a dead feed. Affects stale ALARMS only: index spot is a leg inside
# the index artifacts and never moves a completeness denominator. Set equity_deriv only if
# a live session proves index values keep updating continuously past 15:15.
INDEX_SPOT_SESSION=equity_cash
# Seconds without fresh (content-changing) ticks before the live feed is flagged
# stale/degraded and a self-driven ticker reconnect is triggered. Range: 0 < x <= 300.
CAPTURE_STALE_SECONDS=5
LOG_LEVEL=INFO

# NOTE: the daily Kite access_token is obtained by the automation / `md-login`
# and stored in session state under MARKET_DATA_PATH; it is never set here.
