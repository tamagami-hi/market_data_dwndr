# MARKET_DATA_BUS configuration. Copy to .env beside compose.yaml.
#
# This service holds NO broker credentials. It never authenticates to Kite, never reads
# TickVault BIN files, and never touches TickVault session state. If you find yourself
# wanting to add a secret here, the responsibility probably belongs in TickVault instead.

# Bind addresses INSIDE the container. They are reachable only over the external `mdbus`
# Docker network because compose.yaml publishes no ports to the host. Do not expose these
# to the public Internet; the Tailscale/internal-host boundary is the security perimeter.
MDBUS_INGEST_ENDPOINT=tcp://0.0.0.0:7301
MDBUS_PUBLISH_ENDPOINT=tcp://0.0.0.0:7302
MDBUS_HEALTH_ENDPOINT=tcp://0.0.0.0:7303

# Bounded queues. PULL ingest buffers a burst from TickVault; PUB drops for a slow
# subscriber rather than growing without limit. PUB/SUB is realtime and lossy by design —
# subscribers detect loss with (bus epoch, sequence), and anything needing guaranteed
# history reads TickVault's BIN archive instead.
MDBUS_RCVHWM=50000
MDBUS_SNDHWM=50000

MDBUS_LOG_LEVEL=INFO

# Image tag used by compose (deploy tooling sets this).
APP_VERSION=local
APP_UID=10001
APP_GID=10001
