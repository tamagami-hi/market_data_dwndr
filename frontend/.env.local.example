# Copy to .env.local. This file is the single source for the frontend's config;
# `npm run dev` / `npm run start` load it (via dotenv-cli) so PORT takes effect.

# Backend/API origin — selects HOW the browser reaches the backend. Baked into the image
# at BUILD time (Next inlines NEXT_PUBLIC_* at build), so changing it requires a rebuild.
#
#   • SET to an absolute origin (scheme+host+port) -> ABSOLUTE mode. The browser calls the
#     backend directly there; the port MUST match the backend HTTP_PORT and the origin MUST
#     be listed in the backend's FRONTEND_URL. Use for local dev and tunnelled setups.
#   • LEAVE EMPTY -> SAME-ORIGIN mode. REST becomes relative (/api/...) and the WebSocket
#     base is derived from window.location, so the browser only talks to whatever host
#     served the page; a reverse proxy path-routes /api and /ws to the backend. The image
#     is then domain/scheme-agnostic (rename host or switch http<->https with NO rebuild).
#
# For LOCAL DEV (`npm run dev`, no proxy) keep an absolute value — relative URLs have no
# backend to reach on :3789. For a PROXIED deployment, build with this EMPTY.
NEXT_PUBLIC_BACKEND_URL=http://localhost:9000

# Product display name shown in the UI (title, nav, landing). Baked at build time.
NEXT_PUBLIC_APP_NAME=TickVault

# Port the frontend serves on. Must match the backend's FRONTEND_URL port. Change this
# value if the port is already in use ("EADDRINUSE"). No port is hardcoded in the scripts.
PORT=3789

# Dedicated port for the production-build browser test. Keep it different from PORT
# so the test can run while the local development server is active.
E2E_FRONTEND_PORT=13999
