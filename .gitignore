# Secrets & config
.env
.env.local

# Captured data — never commit
MARKET_DATA/
z_market_data/
*.bin
*.bin.zst
*.tar.gz
*.tar

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/

# Node / Next.js
node_modules/
.next/
out/
dist/

# OS / editor
.DS_Store
*.log

# Release state: staged bundles and the local ship ledger (images and data
# remain outside Git). The last four lines are leftovers of the pipeline before
# release_manager/status.sh; they stay ignored until removed by hand.
release_manager/build/
release_manager/state/*
!release_manager/state/.gitkeep
release_manager/DATA_DOWNLOADER/
release_manager/recent_builds/
release_manager/rollback/
release_manager/.release.lock

# Obsidian workspace (keep notes, ignore local UI state)
.obsidian/workspace*
.obsidian/cache

# Layout audit screenshots (regenerate with layout-audit/shot.mjs)
/layout-audit/*.png
/layout-audit/*.json
/layout-audit/node_modules


# JetBrains IDE metadata (per-developer; no shared project configuration)
.idea/
