# market_data_dwndr backend configuration.
# Copy to `.env` and fill in. `.env` is gitignored -- never commit secrets.
# (This repo only ships this example file; provide the real .env at deploy time.)
# See docs/60-operations/config-and-env.md.

# --- required ---
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
MARKET_DATA_PATH=/data/MARKET_DATA
# Separate durable archive root. EOD compression mirrors the live relative layout here.
ARCHIVE_DATA_PATH=/data/z_market_data
# Optional: directory for persisted monitor statistics JSON (compression history +
# daily capture snapshots). Leave unset to default to MARKET_DATA_PATH/_state/stats.
STATS_DATA_PATH=/data/MARKET_DATA/_state/stats

# --- networking (required; ports come ONLY from here, no code defaults) ---
# Image tag managed by release_manager/deploy.sh. Leave `local` for manual builds.
APP_VERSION=local
# In Docker this is the IN-CONTAINER bind address and MUST be 0.0.0.0, otherwise the
# published port cannot reach uvicorn (127.0.0.1 only works for bare-metal `md-serve`).
# Host exposure is controlled by HOST_BIND_ADDRESS below, not by this value.
HTTP_HOST=0.0.0.0
HTTP_PORT=9000
# Docker publishes both services only on this host address. On the VPS keep this as the
# Tailscale IP (e.g. 100.x.y.z) or 127.0.0.1 — never 0.0.0.0 on a public interface.
HOST_BIND_ADDRESS=127.0.0.1
# Non-root container identity. The two host data directories must be owned by this id.
APP_UID=10001
APP_GID=10001
# Browser page origin(s) allowed by CORS + WebSocket (comma-separate for multiple). This
# is the origin serving the FRONTEND page, not NEXT_PUBLIC_BACKEND_URL. On the VPS set it
# to the Tailscale URL the browser uses, e.g. http://100.122.85.101:3789 — a mismatch
# causes WebSocket 403s and blocked CORS. Must match the frontend PORT below.
FRONTEND_URL=http://localhost:3000

# --- automated login (seeded here so `md-login` can run without a browser) ---
# Optional shared-session lookup. Set both values together. The broker is checked first;
# only an explicit `authenticated: false` falls back to the local credentials below.
KITE_TOKEN_BROKER_URL=https://calspread.online/api/kite/token
KITE_TOKEN_BROKER_PASSCODE=replace_with_a_rotated_random_secret
# The broker token must belong to the same KITE_API_KEY configured above.
# Zerodha login id (e.g. AB1234) and password.
KITE_USER_ID=your_zerodha_user_id
KITE_PASSWORD=your_zerodha_password
# The TOTP is always entered by the user in the frontend or terminal.
# Server-side password login is OPT-IN and off by default. The normal paths are the token
# broker above and, if it is unavailable, the browser OAuth recovery flow
# (GET /api/auth/login-url then POST /api/auth/login). Enabling this lets the backend submit
# the stored KITE_USER_ID/KITE_PASSWORD to Zerodha, which a caller could otherwise use to
# drive repeated upstream authentication; even when enabled it is capped per hour.
KITE_PASSWORD_LOGIN_ENABLED=false
# Daily risk-free rate broker (reuses KITE_TOKEN_BROKER_PASSCODE as x-token-passcode).
# Returns the rate as a percent, e.g. {"rf": 5.3324}; the backend converts to a decimal.
KITE_RATE_BROKER_URL=https://calspread.online/api/rf
# Fallback risk-free rate (decimal, e.g. 0.068) used only when the rate broker above is
# unavailable. The daily value is normally fetched from KITE_RATE_BROKER_URL.
RISK_FREE_RATE=

# --- operator credential (release drain + manual login recovery) ---
# Generate with `openssl rand -hex 32`; use the same secret in the release manager.
# It is accepted only in X-Release-Maintenance-Token and is never returned or logged.
# REQUIRED to use the manual login recovery routes (/api/auth/login*): those endpoints
# fail closed with 503 when it is unset, because they start upstream Zerodha
# authentication and overwrite the day's session. /api/auth/status stays open.
RELEASE_MAINTENANCE_TOKEN=replace_with_at_least_32_random_characters
# A crashed deployment cannot block capture forever (allowed range: 30..900 seconds).
RELEASE_MAINTENANCE_TTL_SECONDS=900

# --- optional (locked defaults shown) ---
INDICES=NIFTY,BANKNIFTY,FINNIFTY,MIDCPNIFTY,SENSEX,BANKEX
# Comma-separated NSE/BSE closure dates (YYYY-MM-DD). Update before each calendar year.
MARKET_HOLIDAYS=
STOCK_UNIVERSE=all
CAPTURE_HZ=1
ZSTD_LEVEL=17
# EOD compression worker threads per file (1..6). Higher = faster multithreaded zstd.
ZSTD_THREADS=6
# Trading-day automation: poll the shared token in [AUTH_POLL_START, AUTH_POLL_END).
AUTH_POLL_START=08:30
AUTH_POLL_END=09:00
AUTH_POLL_INTERVAL_SECONDS=60
# --- three DIFFERENT times, deliberately separate --------------------------------------
# 1. CAPTURE_START_TIME / CAPTURE_END_TIME - when the capture PROCESS runs: connect,
#    subscribe, run the 1 Hz grid. Starts before the market opens so the socket and
#    subscriptions are live before the first print. Nothing is owed in that lead-in, and
#    seconds captured outside a session are reported as `unscheduled`, never as loss.
#    This is a 6h30m PROCESS ENVELOPE (09:10-15:40 = 23,400 s). It is NOT a 6h30m session:
#    the continuous derivative interval inside it is 09:15-15:40 = 6h25m (23,100 s).
#    Ends AT the equity-derivatives close; the post-close drain is EOD_TAIL_SECONDS below,
#    not a longer capture window, so no unscheduled tail seconds are collected.
CAPTURE_START_TIME=09:10
CAPTURE_END_TIME=15:40
# Deliberate safety tail between CAPTURE_END_TIME and EOD compression/archive
# finalization, so the final derivative frames are flushed and the writers drained before
# the raw .bin files are compressed and moved. Compression REMOVES the raw file, so
# running it at 15:40:00 would race the last frames. This is a drain allowance, NOT an
# extension of the market session: nothing is owed in the tail. EOD therefore runs at
# 15:42, never at 15:30 and never while derivatives are still trading.
EOD_TAIL_SECONDS=120
# 2. MARKET_OPEN / MARKET_CLOSE - the broad market/UI display envelope and the source of
#    the expected-frames baseline. It is ALSO the last-resort fallback for an EQUITY_*
#    time that has been explicitly blanked - but it must not be how a segment normally
#    gets its schedule. The segments below genuinely close at different times, and the
#    cash session silently inheriting MARKET_CLOSE is the exact bug that block prevents.
MARKET_OPEN=09:15
MARKET_CLOSE=15:40
# TIMEZONE is also accepted as MARKET_TIMEZONE.
TIMEZONE=Asia/Kolkata
# 3. EQUITY_DERIV_* / EQUITY_CASH_* (further down) - the market SESSIONS, which decide
#    when a frame is genuinely owed. These drive loss accounting and stale escalation.
# Seconds without fresh (content-changing) ticks before the live feed is flagged
# stale/degraded and a self-driven ticker reconnect is triggered. Range: 0 < x <= 300.
CAPTURE_STALE_SECONDS=5
# Skip writing a frame while the feed is stale. A stale grid second holds nothing but
# duplicated last-known values, and the fixed-width .bin layout makes such a frame
# indistinguishable from a real one — permanent, silent corruption of the archive. A
# missing second is visible, counted, and backfillable, so absence is the safer failure.
# Set false only to reproduce the legacy write-anyway behaviour.
CAPTURE_SUPPRESS_STALE_WRITES=true
# --- restart-first recovery ---------------------------------------------------------
# Seconds of CONTINUOUS staleness, WHILE THE MARKET IS TRADING, before the process exits
# so Docker restarts it with a clean socket, fresh subscriptions and a fresh token.
# Replaces the old in-process reconnect ladder, which on 2026-08-06 fired 27 token
# refreshes (obtaining a token on none of them, while deleting that day's session file
# each time) and still left the feed dead for 91 minutes. 0 disables the deadline.
# Keep this comfortably above the restart cost (~30-60s of bootstrap): a restart is
# itself counted as lost grid seconds, so exiting too eagerly costs more than it saves.
CAPTURE_STALE_EXIT_SECONDS=60
# Restart escalations allowed per trading date before giving up and staying online
# (reporting exhausted/recovery_abandoned on /health and the dashboard) rather than
# restarting the container all day. 0 = unlimited.
CAPTURE_STALE_EXIT_MAX_RESTARTS=3
# Seconds of SUSTAINED fresh ticks required to declare a stale spell over. Guards the
# deadline against flickers: on 2026-08-06 a single fresh second reset the old ladder and
# disarmed its escalation for another hour.
CAPTURE_STALE_RECOVERY_CONFIRM_SECONDS=15
# Grace period after MARKET_OPEN before staleness counts as a fault. Capture starts at
# MARKET_OPEN but the exchange's continuous session begins later (MARKET_OPEN=09:10 vs
# NSE 09:15), and silence before then is normal — without this the process would exit
# every minute of every pre-open.
CAPTURE_RECOVERY_ARM_DELAY_SECONDS=300
# NOTE: recovery also arms on EVIDENCE — as soon as the feed delivers any tick inside the
# session — so the delay above no longer gates a feed that worked and then died. It only
# still covers the case where nothing has ever arrived.
#
# --- in-process socket replacement (the rung before a process restart) ---------------
# Seconds of continuous feed-wide staleness before the socket is rebuilt IN PROCESS. Costs
# ~2 s against ~47 s for a full restart, and fixes the common mid-day stall. Recovery used
# to have only "wait for the SDK" and "SIGTERM", so every stall cost a whole restart.
# 0 disables the rung and restores restart-only recovery.
CAPTURE_RECONNECT_AFTER_SECONDS=10
# Cap per rolling hour, so a broker-side problem cannot become a reconnect storm. Once
# spent, recovery falls back to the restart escalation.
CAPTURE_RECONNECT_MAX_PER_HOUR=6
# --- market sessions (see app/ops/sessions.py) --------------------------------------
# Sessions decide WHEN persistence is valid; artifacts (each index file, the stocks file)
# reference a session rather than carrying their own copy of the trading times. Several
# artifacts sharing a session therefore share one setting - there is deliberately no
# NIFTY_CLOSE / STOCK_FNO_CLOSE per-artifact knob.
#
# The 2026 exchange structure has THREE different clocks. Do not collapse them:
#
#   equity derivatives  09:15 -> 15:40 continuous          (23,100 owed seconds)
#   F&O cash underlying 09:15 -> 15:15 continuous          (21,600 owed seconds)
#                       15:15 -> 15:35 closing auction     (1,200 s, captured, NOT owed)
#   process envelope    09:10 -> 15:40                     (23,400 s, owes nothing extra)
#
# Every value below has a concrete default matching the above. Blanking one falls back to
# MARKET_OPEN/MARKET_CLOSE, which is a last resort only - a blank EQUITY_CASH_CLOSE would
# make the cash segment inherit the 15:40 derivatives close and silently claim 25 minutes
# of continuous cash matching that does not happen.
MARKET_TIMEZONE=Asia/Kolkata
# The exchange pre-open call auction. Capturing it is a POLICY, not an assumption: with
# EQUITY_DERIV_CAPTURE_PREOPEN=false the window schedules no frames, so its silence is
# "not expected data" and can never be reported as data loss. Set it true to persist the
# auction for opening price-discovery research. Note the process may be alive from 09:10
# without any contract being expected to print: process running != artifact expected to
# trade, so continuous-market stale detection stays disarmed until the session opens.
EQUITY_DERIV_PREOPEN_START=09:00
EQUITY_DERIV_PREOPEN_END=09:15
EQUITY_DERIV_CAPTURE_PREOPEN=false
# The continuous derivatives session. NSE trades from 09:15; capture before that produced
# the false "dead feed" that cost 9/72/91 minutes on 2026-08-04/05/06.
# 15:40, NOT 15:30 and NOT 15:20: index and stock futures/options keep trading right
# through the cash closing auction. 15:20 is a CASH auction stage, never an F&O close.
EQUITY_DERIV_OPEN=09:15
EQUITY_DERIV_CLOSE=15:40
# Set false to intentionally stop capturing this session. A disabled session schedules no
# seconds at all, which is what distinguishes maintenance from an outage.
EQUITY_DERIV_ENABLED=true
# The F&O-eligible cash underlyings. Their CONTINUOUS session ends at 15:15 - they are not
# continuously traded until the derivatives close, and pretending otherwise reports a
# normal cash close as 25 minutes of missing data.
EQUITY_CASH_OPEN=09:15
EQUITY_CASH_CLOSE=15:15
# The closing auction (CAS). Its sub-stages - reference price, market+limit entry, limit
# stage, randomised entry close, matching - are not modelled individually because nothing
# in the capture path branches on them; TickVault needs CONTINUOUS / AUCTION / CLOSED.
# Inside the auction: frames ARE persisted (closing-price discovery is real market data),
# continuous stale detection is NOT armed, and unchanged values are NOT classified as a
# feed outage. The seconds are tracked separately and never enter the loss denominator.
# Do NOT raise EQUITY_CASH_CLOSE to 15:40 to silence auction alarms: that also silences
# them, by claiming continuous matching that does not exist.
EQUITY_CASH_CAS_START=15:15
EQUITY_CASH_CAS_END=15:35
EQUITY_CASH_CAPTURE_AUCTION=true
EQUITY_CASH_CAPTURE_PREOPEN=false
EQUITY_CASH_ENABLED=true
# Which session governs FRESHNESS for the six index spot values and India VIX. An index
# value is a function of its CASH constituents, so equity_cash is the structurally
# consistent default: from 15:15 an unmoving index level is the cash closing auction, not
# a dead feed. Index spot is a LEG inside the index artifacts, so this affects stale
# ALARMS only and never moves any completeness denominator - the option legs in the same
# file stay on the derivatives session to 15:40 regardless. Set equity_deriv only if a
# live session proves index values keep updating continuously past 15:15.
INDEX_SPOT_SESSION=equity_cash
# --- broker subscription capacity ----------------------------------------------------
# Kite Connect accepts 3000 instruments per websocket and 3 connections per API key. The
# safety margin is the headroom we plan against: crossing it is reported loudly, because a
# rejected subscribe() surfaces only as one log line and a silently dead feed. The planner
# recomputes the universe from the instruments actually resolved at bootstrap, so adding a
# data domain is a measured decision rather than a guess.
BROKER_SUBSCRIPTION_LIMIT=3000
BROKER_SUBSCRIPTION_SAFETY_MARGIN_PCT=10
BROKER_MAX_CONNECTIONS=3
# --- consolidated index-F&O dataset --------------------------------------------------
# Index futures (3 nearest expiries) plus each index's spot, for every index in INDICES,
# on the shared 1 Hz grid in ONE file (MARKET_DATA/INDEX_FNO/<date>.bin). Carrying spot
# alongside futures in the same frame means the basis is computable at a single timestamp
# with no cross-file join, which is what cross-index and calendar-spread research needs.
# Separate from the per-index option files and from the stock F&O file, so no existing
# binary contract changes. Only raw state is stored - basis, spreads and synthetics stay
# reconstruction-time calculations.
INDICES_FNO_ENABLED=true
LOG_LEVEL=INFO

# NOTE: the daily Kite access_token is retrieved or obtained by `md-login` and stored in
# session state (see docs/60-operations/session-state.md); it is never set here.

# --- MARKET_DATA_BUS (realtime distribution to other in-house apps) ---
# The bus is an ADDITIONAL OUTPUT, never a capture dependency. With it disabled TickVault
# behaves exactly as it did before the integration existed; with it enabled but the bus
# down, capture stays healthy and only bus telemetry degrades. Bus availability is
# deliberately NOT part of capture readiness.
MARKET_DATA_BUS_ENABLED=false
# ZMQ PULL ingest socket of the bus, reachable over the internal `mdbus` Docker network.
# Internal only: never point this at a public address.
MARKET_DATA_BUS_INGEST_ENDPOINT=tcp://market-data-bus:7301
# Bounded outbound high-water mark. When full, the message is dropped and counted rather
# than blocking the tick path.
MARKET_DATA_BUS_SNDHWM=10000
# How often the token -> instrument map is republished so a late-joining subscriber can
# interpret tokens without restarting TickVault.
MARKET_DATA_BUS_SESSION_INTERVAL_SECONDS=60
